t\tvar content = inputText.getValue();\n\t\t\t\t\t\t\t\t\tif ( content === '' || content.length < 20 || !content.match( ' ' ) ) {\n\t\t\t\t\t\t\t\t\t\tmw.notify( wb$i18n.alertShort );\n\t\t\t\t\t\t\t\t\t\tinputText.focus();\n\t\t\t\t\t\t\t\t\t\tdialog.getActions().setAbilities({ send: true });\n\t\t\t\t\t\t\t\t\t\treturn;\n\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\tif ( content === '' || content.length > 1500 || !content.match( ' ' ) ) {\n\t\t\t\t\t\t\t\t\t\tmw.notify( wb$i18n.alertLong );\n\t\t\t\t\t\t\t\t\t\tinputText.focus();\n\t\t\t\t\t\t\t\t\t\tdialog.getActions().setAbilities({ send: true });\n\t\t\t\t\t\t\t\t\t\treturn;\n\t\t\t\t\t\t\t\t\t}\n\n\t\t\t\t\t\t\t\t\tvar page = inputPage.getValue()\n\t\t\t\t\t\t\t\t\t\t\t.replace( /^https?:\\/\\/es\\.wikipedia\\.org\\/wiki\\/(.+)$/, '$1' )\n\t\t\t\t\t\t\t\t\t\t\t.replace( /_/g, ' ' );\n\t\t\t\t\t\t\t\t\tpage = decodeURIComponent( page );\n\n\t\t\t\t\t\t\t\t\tif ( page === mw.config.get( 'wgPageName' ).replace( /_/g, ' ' ) &&\n\t\t\t\t\t\t\t\t\t\twb$isValidPageName( mw.config.get( 'wgPageName' ) )\n\t\t\t\t\t\t\t\t\t) {\n\t\t\t\t\t\t\t\t\t\tif ( mw.config.get( 'wgNamespaceNumber' ) === 6 ) {\n\t\t\t\t\t\t\t\t\t\t\tcontent = '{{sust:Reportefalsopositivo|Nombre del artículo =' + wb$i18n.nsFile + mw.config.get( 'wgTitle' ) +\n\t\t\t\t\t\t\t\t\t\t\t\t\t'|Problema encontrado =' + content + '}}';\n\t\t\t\t\t\t\t\t\t\t} else {\n\t\t\t\t\t\t\t\t\t\t\tvar re = new RegExp( '^('+ wb$i18n.nsCat + '|'+ wb$i18n.nsFile + '|\\\\/)' );\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t} else {\n\t\t\t\t\t\t\t\t\t\tpage = page\n\t\t\t\t\t\t\t\t\t\t\t.replace( /\\[\\[([^\\[\\]\\|]+)\\|[^\\[\\]\\|]+\\]\\]/g, '$1' )\n\t\t\t\t\t\t\t\t\t\t\t.replace( /[\\[\\]\\|]/g, '' )\n\t\t\t\t\t\t\t\t\t\t\t.replace( /^\\s+/g, '' )\n\t\t\t\t\t\t\t\t\t\t\t.replace( /\\s+$/g, '' );\n\n\t\t\t\t\t\t\t\t\t\tif ( !wb$isValidPageName( page ) ) {\n\t\t\t\t\t\t\t\t\t\t\tmw.notify( wb$i18n.alertNoPage );\n\t\t\t\t\t\t\t\t\t\t\tif ( wb$isValidPageName( mw.config.get( 'wgPage